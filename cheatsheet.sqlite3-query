-- Suspicion-related summary (if stored by collector)
SELECT id,
       MAX(CASE WHEN key = 'suspicious' THEN bool_value END) AS suspicious,
       MAX(CASE WHEN key = 'suspicion_score' THEN float_value END) AS suspicion_score,
       MAX(CASE WHEN key = 'suspicious_tags' THEN string_value END) AS suspicious_tags
FROM embedding_metadata
GROUP BY id
HAVING suspicious = 1 OR suspicion_score IS NOT NULL OR suspicious_tags IS NOT NULL
ORDER BY COALESCE(suspicion_score, 0) DESC
LIMIT 50;

-- Per-group chunk counts and whether a 'full' part exists
SELECT group_meta.string_value AS group_id,
       COUNT(*) AS parts,
       SUM(CASE WHEN part_meta.string_value = 'full' THEN 1 ELSE 0 END) AS has_full
FROM embedding_metadata part_meta
JOIN embedding_metadata group_meta ON group_meta.id = part_meta.id AND group_meta.key = 'group_id'
WHERE part_meta.key = 'part'
GROUP BY group_meta.string_value
ORDER BY CAST(group_meta.string_value AS INTEGER) DESC
LIMIT 50;

