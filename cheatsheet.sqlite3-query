-- Sanity counts
SELECT COUNT(*) AS total_embeddings FROM embeddings;
SELECT COUNT(*) AS total_metadata_rows FROM embedding_metadata;

-- Distinct metadata keys
SELECT DISTINCT key FROM embedding_metadata ORDER BY key;

-- Collections / segments context
SELECT id, name, dimension, database_id FROM collections;
SELECT id, type, scope, collection FROM segments;

-- Pick one embedding and inspect its metadata (change id as needed)
SELECT * FROM embedding_metadata WHERE id = 11;

-- Parts per request (path/query/headers/body/full/response)
SELECT m.string_value AS part, COUNT(*) AS count
FROM embedding_metadata m
WHERE m.key = 'part'
GROUP BY m.string_value
ORDER BY count DESC;

-- group_id distribution (one per original request)
SELECT string_value AS group_id, COUNT(*) AS chunks
FROM embedding_metadata
WHERE key = 'group_id'
GROUP BY string_value
ORDER BY CAST(string_value AS INTEGER) DESC
LIMIT 20;

-- One doc’s raw content by id
SELECT string_value AS document
FROM embedding_metadata
WHERE id = 11 AND key = 'chroma:document';

-- Count baseline vs traffic docs
SELECT COUNT(*) AS baseline_count
FROM embedding_metadata
WHERE key = 'type' AND string_value = 'baseline';

SELECT COUNT(*) AS traffic_count
FROM embedding_metadata
WHERE key = 'type' AND string_value = 'traffic';

-- Newest N request group_ids
SELECT DISTINCT string_value AS group_id
FROM embedding_metadata
WHERE key = 'group_id'
ORDER BY CAST(string_value AS INTEGER) DESC
LIMIT 10;

