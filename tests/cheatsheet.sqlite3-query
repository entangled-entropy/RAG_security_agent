-------------------
-- Metadata Checks
-------------------
-- Peek at metadata keys (what fields exist)
SELECT DISTINCT key FROM embedding_metadata;

-- Check all docs tagged as 'baseline'
SELECT COUNT(*) 
FROM embedding_metadata 
WHERE key = 'type' AND string_value = 'baseline';

-- Check all traffic docs (non-baseline)
SELECT COUNT(*) 
FROM embedding_metadata 
WHERE key = 'type' AND string_value = 'traffic';

-----------------------------
-- Inspect Requests / Chunks
-----------------------------
-- Pick one embedding and inspect its metadata
SELECT * FROM embedding_metadata WHERE id = 309;

-- Peek at the latest inserted chunks
SELECT id, key, string_value
FROM embedding_metadata
WHERE id IN (SELECT MAX(id) FROM embedding_metadata);

-- Look up all chunks for a specific request
SELECT e.id, m.key, m.string_value
FROM embedding_metadata m
JOIN embeddings e ON m.id = e.id
WHERE m.key = 'group_id' AND m.string_value = '309';

-- Find the newest N requests
SELECT DISTINCT string_value AS group_id
FROM embedding_metadata
WHERE key = 'group_id'
ORDER BY CAST(string_value AS INTEGER) DESC
LIMIT 10;

-- Show all headers captured for request groupid
SELECT m2.string_value
FROM embedding_metadata m1
JOIN embedding_metadata m2 ON m1.id = m2.id
WHERE m1.key = 'part' AND m1.string_value = 'header'
  AND m2.key = 'chroma:document'
  AND m1.id IN (
      SELECT id FROM embedding_metadata
      WHERE key = 'group_id' AND string_value = '134'
  );


-- Check group_id distribution (one per original request)
SELECT string_value AS group_id, COUNT(*) AS chunks
FROM embedding_metadata
WHERE key = 'group_id'
GROUP BY string_value
LIMIT 40;


SELECT em.string_value AS group_id, COUNT(DISTINCT em.id) AS chunk_count
FROM embedding_metadata em
WHERE em.key = 'group_id'
GROUP BY em.string_value
ORDER BY chunk_count DESC
LIMIT 50;


SELECT DISTINCT em.id
FROM embedding_metadata em
WHERE em.key = 'group_id' AND em.string_value = '134';

SELECT group_meta.string_value AS group_id, COUNT(*) AS parts
FROM embedding_metadata part_meta
JOIN embedding_metadata group_meta ON group_meta.id = part_meta.id AND group_meta.key = 'group_id'
WHERE part_meta.key = 'part'
GROUP BY group_meta.string_value
HAVING SUM(CASE WHEN part_meta.string_value = 'full' THEN 1 ELSE 0 END) = 0
LIMIT 50;

SELECT em.string_value AS group_id, COUNT(DISTINCT em.id) AS chunk_count
FROM embedding_metadata em
WHERE em.key = 'group_id'
GROUP BY em.string_value
ORDER BY chunk_count DESC
LIMIT 10;

SELECT DISTINCT em.id
FROM embedding_metadata em
WHERE em.key = 'group_id' AND em.string_value = '135';

-- reconstruct data from id
SELECT part_meta.string_value AS part,
       efs.string_value AS text,
       id_meta.string_value AS stored_id
FROM embedding_metadata part_meta
JOIN embedding_fulltext_search efs ON part_meta.id = efs.rowid
JOIN embedding_metadata id_meta ON id_meta.id = part_meta.id AND id_meta.key = 'id'
JOIN embedding_metadata group_meta ON group_meta.id = part_meta.id AND group_meta.key = 'group_id'
WHERE part_meta.key = 'part' AND group_meta.string_value = '52'
ORDER BY CASE LOWER(part_meta.string_value)
    WHEN 'full' THEN 0
    WHEN 'path' THEN 1
    WHEN 'query' THEN 2
    WHEN 'headers' THEN 3
    WHEN 'body' THEN 4
    ELSE 5 END, part_meta.string_value;


